# База даних користувачів: {Логін: [Пароль, Список оцінок]}
# Створено 4 користувачі (мінімум за умовою)
users = {
    "vlad": ["1234", [10, 8, 12, 4, 5, 3]],
    "olga": ["qwerty", [11, 12, 9, 10, 8]],
    "max": ["pass1", [2, 3, 4, 1, 5]],
    "admin": ["admin", [7, 6, 5, 4, 3, 2, 1]]
}

# Введення даних з клавіатури
login = input("Введіть логін: ")
password = input("Введіть пароль: ")

# Перевірка: чи є такий логін і чи правильно введено пароль
if login in users and users[login][0] == password:
    print("\nАвторизація успішна!")
    
    # Отримуємо список оцінок для цього користувача
    grades = users[login][1]
    print("Ваші оцінки:", grades)
    
    # Лічильники для двох категорій оцінок
    good_grades = 0  # Задовільно (5-12)
    bad_grades = 0   # Незадовільно (1-4)
    
    # Перебираємо кожну оцінку зі списку
    for mark in grades:
        if mark >= 5:
            good_grades = good_grades + 1
        else:
            bad_grades = bad_grades + 1
            
    # Виводимо результати
    print("Кількість задовільних оцінок (5-12):", good_grades)
    print("Кількість незадовільних оцінок (1-4):", bad_grades)
    
else:
    print("\nНевірний логін або пароль!")